# Copy to .env and edit. Every value is optional; the defaults run the app on http://127.0.0.1:8050.

# Where to bind on the host (127.0.0.1 keeps it off the LAN; 0.0.0.0 exposes it):
SAS_BIND=127.0.0.1
SAS_PORT=8050
# Folder on the host for photos, plans and the database:
SAS_DATA=./data
# Concurrent generation jobs ("Run both" uses two):
SAS_WORKERS=2
TZ=UTC

# External path prefix, only when a reverse proxy strips it before forwarding
# (Tailscale: `tailscale serve --bg --set-path /stringart http://127.0.0.1:8050`).
# Leave it empty when you open the app directly on its port.
#SAS_ROOT_PATH=/stringart

# Voice for build mode (Piper in its own container). Uncomment all three lines to switch it on;
# without them build mode uses the browser's own speech.
#COMPOSE_PROFILES=voice
#SAS_PIPER_URL=http://piper:5000
#SAS_PIPER_VOICE=en_US-lessac-medium
