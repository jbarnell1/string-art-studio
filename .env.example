# Copy to .env and edit. Every value is optional.
# External path prefix when a reverse proxy strips it (Tailscale serve --set-path /stringart):
SAS_ROOT_PATH=/stringart
# Where to bind on the host (127.0.0.1 keeps it off the LAN; 0.0.0.0 exposes it):
SAS_BIND=127.0.0.1
SAS_PORT=8050
# Folder on the host for photos, plans and the database:
SAS_DATA=./data
# Concurrent generation jobs ("Run both" uses two):
SAS_WORKERS=2
TZ=America/Chicago
# Voice for build mode (Piper in its own container). Remove both lines for browser speech only.
COMPOSE_PROFILES=voice
SAS_PIPER_URL=http://piper:5000
SAS_PIPER_VOICE=en_US-lessac-medium
